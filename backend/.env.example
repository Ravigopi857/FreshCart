# ─── FreshCart Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file to version control.

# ─── Required ──────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/freshcart

# Secret key for signing JSON Web Tokens. Use a long random string.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000

# ─── CORS ──────────────────────────────────────────────────────────────────
# Production frontend URL. Leave empty to allow any localhost origin in dev.
FRONTEND_ORIGIN=https://your-frontend-domain.com

# NODE_ENV controls CORS behaviour. Set to "production" when deploying.
NODE_ENV=development

# ─── Admin Account ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@freshcart.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!

# ─── Razorpay (optional — required for online payments) ───────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Brevo / Sendinblue SMTP (optional — required for order emails) ────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SENDER_EMAIL=noreply@yourstore.com
BREVO_SENDER_NAME=FreshCart

